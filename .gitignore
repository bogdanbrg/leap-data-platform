*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
crash.log

# Variable files may contain credentials
*.tfvars
*.tfvars.json
!example.tfvars

# Keys and certificates
*.p8
*.pem
*.key

